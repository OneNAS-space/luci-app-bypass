#!/bin/sh /etc/rc.common
USE_PROCD=1
START=90
EXTRA_COMMANDS="refresh_nft sync_clients manage_natmap"
CONF="pw2_guard"
SECTION="global"
readonly LAN_IF=$(uci -q get network.lan.device || uci -q get network.lan.ifname || echo "br-lan")

# PassWall2 tags every connection it proxies with a conntrack mark (FWMARK in its nftables.sh: PSW2_RULE sets
# "ct mark" only for flows that take a proxy rule). Direct flows, bypass_guard's own and PassWall2's, never get it.
# Read from PassWall2 itself so a changed value is followed; the default is the current one.
get_psw_fwmark() {
    local m
    m=$(sed -n 's/^FWMARK="\(0x[0-9a-fA-F]*\)".*/\1/p' /usr/share/passwall2/nftables.sh 2>/dev/null | head -n 1)
    echo "${m:-0x50535732}"
}

# Current L3 devices of wan/wan6 as an nft set literal, e.g. { "pppoe-wan" }.
# Evaluated at call time so PPPoE (device name only exists once connected) works.
get_wan_set() {
    local n d list="" out="" x
    for n in wan wan6; do
        d=$(ifstatus "$n" 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
        [ -n "$d" ] && case " $list " in *" $d "*) ;; *) list="$list $d" ;; esac
    done
    [ -z "$list" ] && list=" $(uci -q get network.wan.device || uci -q get network.wan.ifname || echo wan)"
    for x in $list; do out="${out:+$out, }\"$x\""; done
    echo "{ $out }"
}

del_rules_by_comment() {
    local chain="$1" comment="$2" h
    for h in $(nft -a list chain inet bypass_logic "$chain" 2>/dev/null | grep "\"$comment\"" | sed 's/.*# handle //'); do
        nft delete rule inet bypass_logic "$chain" handle "$h" 2>/dev/null
    done
}

remove_bypass_rules() {
    local table="passwall2"
    nft list table inet "$table" >/dev/null 2>&1 || return 0
    local cleaned=0
    for chain in "mangle_prerouting" "dstnat"; do
        nft list chain inet "$table" "$chain" >/dev/null 2>&1 || continue
        local handles=$(nft -a list chain inet "$table" "$chain" 2>/dev/null | grep -E "Bypass-Global-Mark" | awk -F '# handle ' '{print $2}')
        if [ -n "$handles" ]; then
            for handle in $handles; do
                nft delete rule inet "$table" "$chain" handle "$handle" 2>/dev/null
                cleaned=$((cleaned + 1))
            done
        fi
    done
    [ "$cleaned" -gt 0 ] && logger -t bypass_guard "Cleaned up $cleaned residual rules from passwall2."
}

# Earlier versions identified VPN clients by IP address (sets psw_vpn_clients*, quic_direct_clients*; later a
# server_macs set for the 7844 rules, which now apply to every VPN client) and kept the
# accounting sets as plain sets. Remove what the new rules replace; everything that is removed is re-created by
# setup_nft. The accounting sets are kept (with their counters) once they have the new, dynamic definition.
migrate_legacy_nft() {
    local c s

    nft flush chain inet bypass_logic dynamic_logic 2>/dev/null
    for c in client_acct acct_in acct_out; do
        nft flush chain inet bypass_logic $c 2>/dev/null
        nft delete chain inet bypass_logic $c 2>/dev/null
    done
    if nft list chain inet bypass_logic static_privilege 2>/dev/null | grep -Eq 'quic_direct_clients|server_macs'; then
        for c in P2P-Tunnel-Setup-tcp-Direct P2P-Tunnel-Setup-udp-Direct P2P-Tunnel-Setup6-tcp-Direct P2P-Tunnel-Setup6-udp-Direct; do
            del_rules_by_comment static_privilege "$c"
        done
    fi
    for s in psw_vpn_clients psw_vpn_clients6 quic_direct_clients quic_direct_clients6 server_macs; do
        nft delete set inet bypass_logic $s 2>/dev/null
    done
    for s in acct_up4 acct_dn4 acct_up6 acct_dn6; do
        nft list set inet bypass_logic $s 2>/dev/null | grep -q 'flags dynamic' || nft delete set inet bypass_logic $s 2>/dev/null
    done
}

setup_nft() {
    local wan_set=$(get_wan_set)
    local psw_mark=$(get_psw_fwmark)

    nft add table inet bypass_logic 2>/dev/null
    migrate_legacy_nft
    if ! nft list chain inet bypass_logic static_privilege >/dev/null 2>&1; then
        nft "add chain inet bypass_logic static_privilege { type filter hook prerouting priority -410; policy accept; }" 2>/dev/null
    fi
    if ! nft list chain inet bypass_logic static_privilege_output >/dev/null 2>&1; then
        nft "add chain inet bypass_logic static_privilege_output { type filter hook output priority -410; policy accept; }" 2>/dev/null
    fi

    # VPN clients are identified by MAC address (the "mac" of the DHCP host entries tagged VPN), not by IP:
    # a device keeps being a VPN client whatever addresses it takes (privacy / temporary IPv6, tokens, renumbering).
    # The set is refilled by sync_clients; its elements are bare MACs.
    nft "add set inet bypass_logic vpn_macs { type ether_addr; }" 2>/dev/null
    nft "add set inet bypass_logic qb_dynamic_ports { type inet_service; flags timeout; }" 2>/dev/null
    nft "add set inet bypass_logic qb_outer_ports { type inet_service; }" 2>/dev/null
    nft "add set inet bypass_logic stun_direct { type ipv4_addr; flags interval; }" 2>/dev/null

    # Connections of the VPN clients to remote port 7844 go direct: these set up peer-to-peer tunnels (Cloudflare
    # tunnels, NetBird, WireGuard and similar) and have to leave without the proxy.
    # (Rules of earlier versions are removed by migrate_legacy_nft.)
    if ! nft list table inet bypass_logic | grep -q "P2P-Tunnel-Setup-tcp-Direct"; then
        nft add rule inet bypass_logic static_privilege iifname "$LAN_IF" ether saddr @vpn_macs meta nfproto ipv4 tcp dport 7844 counter meta mark set 0xff accept comment "P2P-Tunnel-Setup-tcp-Direct"
    fi
    if ! nft list table inet bypass_logic | grep -q "P2P-Tunnel-Setup-udp-Direct"; then
        nft add rule inet bypass_logic static_privilege iifname "$LAN_IF" ether saddr @vpn_macs meta nfproto ipv4 udp dport 7844 counter meta mark set 0xff accept comment "P2P-Tunnel-Setup-udp-Direct"
    fi
    if ! nft list table inet bypass_logic | grep -q "P2P-Tunnel-Setup6-tcp-Direct"; then
        nft add rule inet bypass_logic static_privilege iifname "$LAN_IF" ether saddr @vpn_macs meta nfproto ipv6 tcp dport 7844 counter meta mark set 0xff accept comment "P2P-Tunnel-Setup6-tcp-Direct"
    fi
    if ! nft list table inet bypass_logic | grep -q "P2P-Tunnel-Setup6-udp-Direct"; then
        nft add rule inet bypass_logic static_privilege iifname "$LAN_IF" ether saddr @vpn_macs meta nfproto ipv6 udp dport 7844 counter meta mark set 0xff accept comment "P2P-Tunnel-Setup6-udp-Direct"
    fi
    del_rules_by_comment static_privilege "qB-tcp-Inbound-Mark-Direct"
    del_rules_by_comment static_privilege "qB-udp-Inbound-Mark-Direct"
    nft add rule inet bypass_logic static_privilege iifname $wan_set tcp dport @qb_outer_ports counter meta mark set 0xff accept comment "qB-tcp-Inbound-Mark-Direct"
    nft add rule inet bypass_logic static_privilege iifname $wan_set udp dport @qb_outer_ports counter meta mark set 0xff accept comment "qB-udp-Inbound-Mark-Direct"

    if ! nft list table inet bypass_logic | grep -q "qB-tcp-dport-Direct"; then
        nft add rule inet bypass_logic static_privilege tcp dport @qb_dynamic_ports counter meta mark set 0xff accept comment "qB-tcp-dport-Direct"
    fi
    if ! nft list table inet bypass_logic | grep -q "qB-tcp-sport-Direct"; then
        nft add rule inet bypass_logic static_privilege tcp sport @qb_dynamic_ports counter meta mark set 0xff accept comment "qB-tcp-sport-Direct"
    fi
    if ! nft list table inet bypass_logic | grep -q "qB-udp-dport-Direct"; then
        nft add rule inet bypass_logic static_privilege udp dport @qb_dynamic_ports counter meta mark set 0xff accept comment "qB-udp-dport-Direct"
    fi
    if ! nft list table inet bypass_logic | grep -q "qB-udp-sport-Direct"; then
        nft add rule inet bypass_logic static_privilege udp sport @qb_dynamic_ports counter meta mark set 0xff accept comment "qB-udp-sport-Direct"
    fi

    # Addresses of the VPN clients, learned from the traffic itself: every packet that comes from a VPN client's MAC
    # (see vpn_macs) refreshes its source address in vpn_seen4/6, which expire after an hour without traffic. So the
    # page only lists addresses a client really uses, and they never need to be configured or looked up.
    # Link-local and unspecified addresses are not recorded.
    nft "add set inet bypass_logic vpn_seen4 { type ipv4_addr; flags dynamic,timeout; timeout 1h; size 1024; }" 2>/dev/null
    nft "add set inet bypass_logic vpn_seen6 { type ipv6_addr; flags dynamic,timeout; timeout 1h; size 1024; }" 2>/dev/null

    # Per-client traffic accounting for the LuCI page: sets with per-element counters, separate for upload (source)
    # and download (destination). The elements are created by the rules below the first time a client's proxied
    # traffic is seen, and are kept for a week without any. Not flushed on sync, so the counters survive a re-sync
    # and only reset when the service stops.
    nft "add set inet bypass_logic acct_up4 { type ipv4_addr; flags dynamic,timeout; timeout 7d; size 1024; counter; }" 2>/dev/null
    nft "add set inet bypass_logic acct_dn4 { type ipv4_addr; flags dynamic,timeout; timeout 7d; size 1024; counter; }" 2>/dev/null
    nft "add set inet bypass_logic acct_up6 { type ipv6_addr; flags dynamic,timeout; timeout 7d; size 1024; counter; }" 2>/dev/null
    nft "add set inet bypass_logic acct_dn6 { type ipv6_addr; flags dynamic,timeout; timeout 7d; size 1024; counter; }" 2>/dev/null

    # Only traffic that PassWall2 proxies is counted (ct mark == PassWall2's FWMARK, see get_psw_fwmark): the page
    # shows what a client sends through the proxy. Direct traffic (bypass_guard rules, PassWall2 direct rules) and
    # traffic to the router itself are not included. A set element counter is bumped by every lookup that matches
    # it, so each counting set is only ever touched by the one rule that updates it: membership tests use the
    # counter-less vpn_seen sets instead.
    # Upload is counted in prerouting, download in postrouting. Unlike the forward hook these also see the
    # traffic PassWall2 handles: its TPROXY delivers packets to a local process (input) and the replies are
    # generated locally (output), neither of which is ever "forwarded". The upload chain has to run after
    # PassWall2's own prerouting chains (priority -151 and later), which is where the first packet of a flow gets
    # its ct mark. (Chains of earlier versions were removed by migrate_legacy_nft.)
    nft "add chain inet bypass_logic acct_in { type filter hook prerouting priority -50; policy accept; }"
    nft "add chain inet bypass_logic acct_out { type filter hook postrouting priority 0; policy accept; }"
    nft add rule inet bypass_logic acct_in iifname "$LAN_IF" ether saddr @vpn_macs ip saddr != 0.0.0.0 update @vpn_seen4 { ip saddr }
    nft add rule inet bypass_logic acct_in iifname "$LAN_IF" ether saddr @vpn_macs ip6 saddr != "{ fe80::/10, ::/128 }" update @vpn_seen6 { ip6 saddr }
    nft add rule inet bypass_logic acct_in iifname "$LAN_IF" ct mark $psw_mark ether saddr @vpn_macs ip saddr != 0.0.0.0 update @acct_up4 { ip saddr }
    nft add rule inet bypass_logic acct_in iifname "$LAN_IF" ct mark $psw_mark ether saddr @vpn_macs ip6 saddr != "{ fe80::/10, ::/128 }" update @acct_up6 { ip6 saddr }
    nft add rule inet bypass_logic acct_out oifname "$LAN_IF" ct mark $psw_mark ip daddr @vpn_seen4 update @acct_dn4 { ip daddr }
    nft add rule inet bypass_logic acct_out oifname "$LAN_IF" ct mark $psw_mark ip6 daddr @vpn_seen6 update @acct_dn6 { ip6 daddr }

    if ! nft list chain inet bypass_logic dynamic_logic >/dev/null 2>&1; then
        nft "add chain inet bypass_logic dynamic_logic { type filter hook prerouting priority -400; policy accept; }"
    fi

    nft flush chain inet bypass_logic dynamic_logic

    if ! nft list chain inet bypass_logic qb_fix >/dev/null 2>&1; then
        nft "add chain inet bypass_logic qb_fix { type nat hook prerouting priority -110; }"
    fi

    nft add rule inet bypass_logic dynamic_logic fib daddr type local meta mark != 0xff counter return comment "Local-Fix"

    local lan_addr=$(ip -4 -o addr show dev "$LAN_IF" scope global 2>/dev/null | awk '{print $4}' | head -n1)
    if [ -n "$lan_addr" ]; then
        nft add rule inet bypass_logic dynamic_logic ip daddr "$lan_addr" counter return comment "Loopback-Fix"
    fi

    local lan_addr6=$(ip -6 addr show dev "$LAN_IF" | grep 'scope global' | awk '{print $2}' | head -n1)
    if [ -n "$lan_addr6" ]; then
        nft add rule inet bypass_logic dynamic_logic ip6 daddr "$lan_addr6" counter return comment "Loopback-v6-Fix"
    fi

    # Always hand VPN clients over to PassWall2 (mark 0). If PassWall2 is not running
    # nothing catches them and they simply go direct, so no boot-order dependency.
    nft add rule inet bypass_logic dynamic_logic iifname "$LAN_IF" ether saddr @vpn_macs meta nfproto ipv4 meta mark != 0xff counter meta mark set 0 accept comment "AGENT-PASS"
    nft add rule inet bypass_logic dynamic_logic iifname "$LAN_IF" ether saddr @vpn_macs meta nfproto ipv6 meta mark != 0xff counter meta mark set 0 accept comment "AGENT-PASS-V6"

    # Everything left from the LAN here belongs to devices that are not VPN clients: mark it 0xff so
    # PassWall2 leaves it alone and it goes out directly. Packets that already carry 0xff were sent direct by a
    # rule of static_privilege (this chain still sees them after that chain accepted them): they are not counted
    # a second time, and there is nothing left to do for them.
    nft add rule inet bypass_logic dynamic_logic iifname "$LAN_IF" meta mark != 0xff counter meta mark set 0xff accept comment "Non-VPN-Client-Direct"

}

sync_clients() {
    config_load "$CONF"
    config_load "dhcp"
    local vpn_sections=$(uci show dhcp | grep "@host" | grep "\.tag" | grep -i "VPN" | cut -d. -f2 | sort -u)

    local nft_file="/tmp/bypass_guard_sync.nft"
    local section mac

    # Flush and refill the set in ONE nft transaction, so there is no empty window and a failure leaves the
    # previous contents untouched. (The Server tag is only a label on the page; it needs no rule.)
    {
        echo "flush set inet bypass_logic vpn_macs"

        for section in $vpn_sections; do
            for mac in $(uci -q get "dhcp.$section.mac"); do
                case "$mac" in
                    ??:??:??:??:??:??) ;;
                    *) continue ;;
                esac
                echo "add element inet bypass_logic vpn_macs { $mac }"
            done
        done
    } > "$nft_file"

    local err rc
    err=$(nft -f "$nft_file" 2>&1)
    rc=$?
    rm -f "$nft_file"

    if [ "$rc" -ne 0 ]; then
        logger -t bypass_guard "Sync: FAILED to update client sets, keeping previous entries: $(echo "$err" | head -n 3 | tr '\n' ' ')"
        return 1
    fi

    if [ -z "$vpn_sections" ]; then
        logger -t bypass_guard "Sync: No VPN tagged hosts detected, client sets cleared."
    else
        logger -t bypass_guard "Sync: Updated VPN clients."
    fi
}

manage_natmap() {
    local natmap_en="$1"
    local stun_script="/usr/share/bypass_guard/scripts/stun_sync.sh"
    local script_path="/usr/share/bypass_guard/scripts/natmap_bypass.sh"
    local cache_dir="/tmp/natmap_cache"
    local qb_port_file="/tmp/natmap_qb_inner_port"
    local qb_outer_port_file="/tmp/natmap_cache/natmap_last_port"

    if [ "$natmap_en" -eq 1 ] && [ -f "$stun_script" ]; then
        nft flush chain inet bypass_logic static_privilege_output
        if ! nft list chain inet bypass_logic static_privilege_output | grep -q "STUN-UDP-Direct"; then
            nft add rule inet bypass_logic static_privilege_output ip daddr @stun_direct udp dport 3478 meta mark set 0xff counter accept comment "STUN-UDP-Direct"
        fi

        if ! nft list chain inet bypass_logic static_privilege_output | grep -q "STUN-TCP-Direct"; then
            nft add rule inet bypass_logic static_privilege_output ip daddr @stun_direct tcp dport 3478 meta mark set 0xff counter accept comment "STUN-TCP-Direct"
        fi

        sh "$stun_script" &
    else
        nft flush chain inet bypass_logic static_privilege_output 2>/dev/null
        nft flush set inet bypass_logic stun_direct 2>/dev/null
        rm -f /tmp/stun_servers.etag /tmp/stun_servers.txt
    fi

    if [ -d "$cache_dir" ]; then
        for ext in tcp_fix_rule old_port; do
            ls -t "$cache_dir"/*."$ext" 2>/dev/null | awk '{
                line = "cat " $1; line | getline content; close(line);
                if (content in seen) {
                    system("rm -f " $1); 
                } else {
                    seen[content] = $1;
                }
            }' 2>/dev/null
        done
    fi

    if ! nft list chain inet bypass_logic qb_fix >/dev/null 2>&1; then
        nft "add chain inet bypass_logic qb_fix { type nat hook prerouting priority -110; }" 2>/dev/null
    fi
    if ! nft list set inet bypass_logic qb_outer_ports >/dev/null 2>&1; then
        nft "add set inet bypass_logic qb_outer_ports { type inet_service; }" 2>/dev/null
    fi
    if [ "$natmap_en" -ne 1 ]; then
        local changed=0
        config_load natmap
        do_detach() {
            local section="$1"
            local comment current
            config_get comment "$section" "comment"
            [ "$comment" = "qBittorrent" ] || return 0
            config_get current "$section" "custom_script"
            if [ "$current" = "$script_path" ]; then
                uci set natmap."$section".custom_script=""
                changed=1
            fi
        }
        config_foreach do_detach natmap
        if [ "$changed" -eq 1 ]; then
            uci commit natmap
            /etc/init.d/natmap reload
        fi

        nft flush chain inet bypass_logic qb_fix 2>/dev/null
        nft flush set inet bypass_logic qb_outer_ports 2>/dev/null
        return 0
    fi

    local changed=0
    config_load natmap
    do_attach() {
        local section="$1"
        local comment current
        config_get comment "$section" "comment"
        [ "$comment" = "qBittorrent" ] || return 0
        config_get current "$section" "custom_script"
        if [ "$current" != "$script_path" ]; then
            uci set natmap."$section".custom_script="$script_path"
            changed=1
        fi
    }
    config_foreach do_attach natmap
    if [ "$changed" -eq 1 ]; then
        uci commit natmap
        /etc/init.d/natmap reload
    fi

    if [ -d "$cache_dir" ]; then
        if ls "$cache_dir"/*.tcp_fix_rule >/dev/null 2>&1; then
            unique_rules=$(cat "$cache_dir"/*.tcp_fix_rule 2>/dev/null | sort -u)
        fi
    fi
    {
        echo "flush chain inet bypass_logic qb_fix"
        if [ -n "$unique_rules" ]; then
            local wan_set=$(get_wan_set)
            echo "$unique_rules" | while read -r rule; do
                rule=$(echo "$rule" | sed "s|__WAN__|$wan_set|")
                [ -n "$rule" ] && echo "add rule inet bypass_logic qb_fix $rule"
            done
        fi
    } | nft -f - 2>/dev/null

    if [ -f "$qb_port_file" ]; then
        local p=$(cat "$qb_port_file")
        if [ -n "$p" ]; then
            nft "add element inet bypass_logic qb_dynamic_ports { $p }" 2>/dev/null
            logger -t bypass_guard "Sync: Restored cached qB Port $p"
        fi
    else
        logger -t bypass_guard "Sync: No natmap cache found, skipping port restore"
    fi

    if [ -f "$qb_outer_port_file" ]; then
        local op=$(cat "$qb_outer_port_file")
        if [ -n "$op" ]; then
            # Replace (not append): ports of earlier STUN mappings must not stay marked direct.
            printf 'flush set inet bypass_logic qb_outer_ports\nadd element inet bypass_logic qb_outer_ports { %s }\n' "$op" | nft -f - 2>/dev/null
            logger -t bypass_guard "Sync: Restored cached qB Outer Port $op"
        fi
    else
        logger -t bypass_guard "Sync: No natmap cache found, skipping outer port restore"
    fi
}

refresh_nft() {
    setup_nft
    sync_clients
}

start_service() {
    local enabled natmap_en
    config_load "$CONF"
    config_get_bool enabled "$SECTION" "enable_bypass" 0
    config_get_bool natmap_en "$SECTION" "enable_natmap" 0

    if [ "$enabled" -eq 0 ]; then
        logger -t bypass_guard "Service disabled in config. Exiting."
        stop_service
        return 0
    fi

    logger -t bypass_guard "DEBUG: refresh_nft triggered by [INIT_START]"
    refresh_nft
    manage_natmap "$natmap_en"

    procd_open_instance "psw_monitor"
    # No work to do here anymore: PassWall2 inserts the 0xff return rules itself.
    # Keep a tiny resident instance so that "status" reports running (used by LuCI).
    # A single sleep process (no shell loop): procd stops exactly this process on restart, so no
    # orphaned "sleep 3600" is left behind by the loop's child.
    procd_set_param command /bin/sleep 2147483647
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    local natmap_en
    config_load "$CONF"
    config_get_bool natmap_en "$SECTION" "enable_natmap" 0
    [ "$natmap_en" -eq 1 ] && manage_natmap 0
    remove_bypass_rules
    nft delete table inet bypass_logic 2>/dev/null
}

reload_service() {
    local enabled natmap_en
    config_load "$CONF"
    config_get_bool enabled "$SECTION" "enable_bypass" 0
    [ "$enabled" -eq 0 ] && return 0
    config_get_bool natmap_en "$SECTION" "enable_natmap" 0
    logger -t bypass_guard "DEBUG: refresh_nft triggered by [RELOAD_FUNC]"
    refresh_nft
    manage_natmap "$natmap_en"
}

service_triggers() {
    procd_add_reload_trigger "passwall2"
    procd_add_reload_trigger "dhcp"
    procd_add_interface_trigger "interface.*.up" "wan" /etc/init.d/bypass_guard reload
    procd_add_interface_trigger "interface.*.up" "wan6" /etc/init.d/bypass_guard reload
}
